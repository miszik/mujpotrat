---
const navLinks = [
  { href: '/', label: 'Články' },
  { href: '/kde-hledat-pomoc', label: 'Kde hledat pomoc' },
  { href: '/o-mne', label: 'O mně' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo">Můj potrat</a>

    <button class="nav-toggle" aria-label="Otevřít menu" aria-expanded="false" aria-controls="main-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="main-nav">
      <ul class="site-nav" role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav = document.querySelector('.site-nav') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !nav?.contains(e.target as Node)) {
      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
