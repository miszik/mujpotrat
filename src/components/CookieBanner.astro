<div id="cookie-banner" style="display:none">
  <p>Tento web používá Google Analytics pro sledování návštěvnosti. Bez souhlasu měří anonymně.</p>
  <div class="cookie-buttons">
    <button id="cookie-accept" class="btn-cookie btn-cookie-accept">Souhlasím</button>
    <button id="cookie-reject" class="btn-cookie btn-cookie-reject">Odmítnout</button>
  </div>
</div>

<style>
#cookie-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #2C2C2C;
  color: #f5f5f5;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  font-family: system-ui, sans-serif;
  font-size: 0.88rem;
  z-index: 9999;
  flex-wrap: wrap;
}
#cookie-banner p { margin: 0; line-height: 1.5; }
.cookie-buttons { display: flex; gap: 0.75rem; flex-shrink: 0; }
.btn-cookie {
  padding: 0.45rem 1.1rem;
  border: none;
  border-radius: 5px;
  font-size: 0.88rem;
  cursor: pointer;
  font-weight: 500;
}
.btn-cookie-accept { background: #7BAFC4; color: white; }
.btn-cookie-reject { background: transparent; color: #ccc; border: 1px solid #555; }
.btn-cookie-reject:hover { color: white; border-color: #999; }
</style>

<script>
(function () {
  const consent = localStorage.getItem('ga-consent');
  if (consent) return;

  const banner = document.getElementById('cookie-banner');
  banner.style.display = 'flex';

  document.getElementById('cookie-accept').addEventListener('click', () => {
    localStorage.setItem('ga-consent', 'granted');
    gtag('consent', 'update', { analytics_storage: 'granted' });
    banner.style.display = 'none';
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    localStorage.setItem('ga-consent', 'denied');
    banner.style.display = 'none';
  });
})();
</script>
