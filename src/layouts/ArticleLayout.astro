---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;

const formatted = date.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout title={title} description={description}>
  <div class="container prose">
    <a href="/" class="back-link">Zpět na přehled</a>
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <p class="article-date">{formatted}</p>
      </header>
      <div class="article-body">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
