---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Kontakt"
  description="Nejrychlejší spojení s Míšou je přes Instagram @mujpotrat nebo e-mail."
>
  <div class="container prose">
    <h1 class="page-title">Kontakt</h1>
    <p class="page-subtitle">Jestli ti to pomůže, klidně mi napiš.</p>

    <ul class="contact-links">
      <li>
        📷 Instagram:
        <a href="https://instagram.com/mujpotrat" target="_blank" rel="noopener">
          @mujpotrat
        </a>
      </li>
      <li>
        ✉️ E-mail:
        <a href="mailto:miejja@gmail.com">miejja@gmail.com</a>
      </li>
    </ul>
  </div>
</BaseLayout>
