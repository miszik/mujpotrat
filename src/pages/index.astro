---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TriggerWarning from '../components/TriggerWarning.astro';
import ArticleCard from '../components/ArticleCard.astro';

const allArticles = await getCollection('clanky');

const byDate = (a: any, b: any) => b.data.date.getTime() - a.data.date.getTime();

const pinned = allArticles.filter(a => a.data.pinned).sort(byDate);

const sections = [
  { key: 'moje-pribehy',  label: 'Moje příběhy' },
  { key: 'telo-a-pece',   label: 'Tělo a péče' },
  { key: 'pribehy-jinych',label: 'Příběhy jiných' },
  { key: 'ostatni',       label: 'Ostatní' },
].map(s => ({
  ...s,
  articles: allArticles
    .filter(a => !a.data.pinned && a.data.kategorie === s.key)
    .sort(byDate),
}));
---
<BaseLayout title="Můj potrat">
  <TriggerWarning />

  <div class="container prose">
    <div class="site-intro-hero">
      <p class="site-intro-text">
        Blog Míši. O třech potratech, o tichu po nich, o hledání cesty dál.
        Psaný proto, aby se v tom žádná žena nemusela cítit sama.
      </p>
      <img
        src="/images/ja.jpg"
        alt="Míša"
        class="site-intro-photo"
        loading="eager"
      />
    </div>

    {pinned.length > 0 && (
      <section class="article-section">
        <h2 class="section-heading">Úvodní článek</h2>
        <ul class="article-list" role="list">
          {pinned.map(article => (
            <ArticleCard
              title={article.data.title}
              slug={article.id}
              date={article.data.date}
              description={article.data.description}
              pinned={article.data.pinned}
            />
          ))}
        </ul>
      </section>
    )}

    <nav class="category-grid" aria-label="Kategorie článků">
      {sections.map(s => (
        <a href={`/kategorie/${s.key}/`} class={`category-card category-card--${s.key}`}>
          <div class="category-card__image">
            <img
              src={`/images/kategorie-${s.key}.png`}
              alt={s.label}
              onerror="this.style.display='none'"
              loading="lazy"
            />
          </div>
          <div class="category-card__body">
            <span class="category-card__label">{s.label}</span>
            <span class="category-card__count">{s.articles.length} článků</span>
          </div>
        </a>
      ))}
    </nav>

    {sections.map(s => s.articles.length > 0 && (
      <section class="article-section">
        <h2 class="section-heading">{s.label}</h2>
        <ul class="article-list" role="list">
          {s.articles.map(article => (
            <ArticleCard
              title={article.data.title}
              slug={article.id}
              date={article.data.date}
              description={article.data.description}
              pinned={false}
            />
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
