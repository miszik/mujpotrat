---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('clanky');
const slugs = articles.map(a => a.id);
---
<BaseLayout title="Stránka nenalezena">
  <div class="container prose">
    <div class="not-found">
      <h1 class="not-found__title">Stránka nenalezena</h1>
      <p class="not-found__lead" id="nf-msg">
        Omlouvám se — odkaz, který máš uložený, pravděpodobně pochází ze starého blogu,
        který jsem musela obnovit od začátku. Zkusím tě automaticky přesměrovat…
      </p>
      <div id="nf-redirect-info" style="display:none" class="not-found__redirect"></div>
      <div class="not-found__links">
        <p>Nebo zkus najít článek ručně:</p>
        <a href="/kategorie/moje-pribehy/" class="not-found__cat">Moje příběhy</a>
        <a href="/kategorie/telo-a-pece/" class="not-found__cat">Tělo a péče</a>
        <a href="/kategorie/pribehy-jinych/" class="not-found__cat">Příběhy jiných</a>
        <a href="/kategorie/ostatni/" class="not-found__cat">Ostatní</a>
        <a href="/" class="btn-home">← Zpět na úvod</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ slugs }}>
  // Pokus o automatické přesměrování podle slugu z URL
  const path = window.location.pathname.replace(/^\/|\/$/g, '');
  const parts = path.split('/');
  const candidate = parts[parts.length - 1];

  function normalize(s) {
    return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  const normalized = normalize(candidate);

  // Přesná shoda
  if (slugs.includes(normalized)) {
    window.location.replace('/clanky/' + normalized + '/');
  } else {
    // Částečná shoda — hledáme slug, který obsahuje kandidáta nebo naopak
    const match = slugs.find(s =>
      normalize(s).includes(normalized) || normalized.includes(normalize(s).slice(0, 10))
    );
    if (match) {
      window.location.replace('/clanky/' + match + '/');
    } else {
      // Nepodařilo se — zobraz info
      document.getElementById('nf-msg').textContent =
        'Omlouvám se — odkaz, který máš uložený, pochází ze starého blogu, který jsem musela obnovit od začátku. Článek se mi bohužel nepodařilo automaticky najít.';
    }
  }
</script>

<style>
.not-found {
  max-width: 560px;
  margin: 4rem auto;
  text-align: center;
}
.not-found__title {
  font-size: 2rem;
  margin-bottom: 1.5rem;
  color: var(--text);
}
.not-found__lead {
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 2.5rem;
}
.not-found__redirect {
  background: var(--blue-light);
  border-radius: 8px;
  padding: 1rem;
  margin-bottom: 2rem;
  font-size: 0.9rem;
}
.not-found__links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}
.not-found__links p {
  color: var(--muted);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}
.not-found__cat {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  background: var(--cream);
  border-radius: 6px;
  text-decoration: none;
  color: var(--text);
  font-size: 0.9rem;
  width: 220px;
}
.not-found__cat:hover { background: var(--blue-light); }
.btn-home {
  margin-top: 0.75rem;
  color: var(--blue-dark);
  font-size: 0.9rem;
}
</style>
